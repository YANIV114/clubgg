# ── Database ────────────────────────────────────────────────────────────────
# asyncpg DSN used by the app at runtime
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/clubgg
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# REQUIRED in production — startup will fail if left as the default dev value
JWT_SECRET_KEY=dev-secret-change-in-production-minimum-32-chars!!
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Beta access gate ──────────────────────────────────────────────────────────
# When set, /auth/register requires a matching invite_code in the request body.
# Matching users get is_tester=True and full access. Leave empty to disable gate.
# REQUIRED in production — startup will fail if left empty.
BETA_INVITE_CODE=change-me-before-sharing

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (used in staging/production).
# In development the wildcard "*" is used regardless of this value.
# REQUIRED in production — startup will fail if left empty.
# Example: https://app.clubgg.com,https://admin.clubgg.com
CORS_ORIGINS=https://your-domain.com

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys (test keys for dev/staging)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...
BILLING_SUCCESS_URL=http://localhost:8000/account?billing=success
BILLING_CANCEL_URL=http://localhost:8000/pricing

# ── ClubGG API ───────────────────────────────────────────────────────────────
CLUBGG_BASE_URL=https://api.clubgg.net
# Comma-separated list of club IDs to ingest
CLUBGG_CLUB_IDS=12345,67890
# Shared API key; override per-club with CLUBGG_API_KEY_<CLUB_ID>
CLUBGG_API_KEY=your-api-key-here
CLUBGG_REQUEST_TIMEOUT=30

# ── Hand history file ingestion ───────────────────────────────────────────────
HAND_HISTORY_WATCH_DIR=/tmp/hand_histories
HAND_HISTORY_PROCESSED_DIR=/tmp/hand_histories/processed

# ── Scheduler intervals (seconds) ────────────────────────────────────────────
INGEST_HANDS_INTERVAL_SECONDS=300
INGEST_PLAYERS_INTERVAL_SECONDS=1800
INGEST_TABLES_INTERVAL_SECONDS=900
INGEST_TRANSACTIONS_INTERVAL_SECONDS=300
INGEST_FILE_POLL_INTERVAL_SECONDS=60

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# development | staging | production
ENVIRONMENT=development
